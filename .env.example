# copie este arquivo para ".env" e troque as senhas
# o docker compose e os scripts python leem daqui

# banco (porta 5433 no computador para nao brigar com um postgres local na 5432)
POSTGRES_DB=pesquisa_evasao
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# cube: segredo usado para assinar os tokens da API REST
CUBEJS_API_SECRET=troque_este_segredo_longo
# usuario e senha que o Power BI usa para conectar no Cube
CUBEJS_SQL_USER=powerbi
CUBEJS_SQL_PASSWORD=troque_esta_senha_tambem
